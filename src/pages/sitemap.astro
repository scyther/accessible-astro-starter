---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Notification } from 'accessible-astro-components'
import { getCollection } from 'astro:content'

// Get all blog posts
const blogs = await getCollection('blogs')

// Define static pages with their descriptions
const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'Welcome to DevCase — A SaaS platform and blog exploring modern development practices, tools, and industry insights.',
  },
  {
    title: 'Blog',
    url: '/blog',
    description: 'In-depth articles, setup guides, and technical insights for developers using DevCase and modern development tools.',
  },
  {
    title: 'Contact',
    url: '/contact',
    description: 'Connect with the DevCase team for questions, feedback, partnership opportunities, or support.',
  },
]
---

<DefaultLayout
  title="Sitemap"
  description="Complete site map showing all pages, articles, and resources available on the DevCase blog and platform."
>
  <PageHeader
    title="Sitemap"
    subtitle="Explore DevCase — Your guide to modern development solutions, insights, and resources."
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container space-y-12">
      <!-- Main Pages Section -->
      <div>
        <Heading level="h2" class="mb-6">Main pages</Heading>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={page.url}>{page.title}</a>
                </Heading>
                <p class="mb-3">{page.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Blog Posts Section -->
      <div>
        <Heading level="h2">Blog posts</Heading>
        <p class="mb-6">
          Discover {blogs.length} articles from the DevCase team covering development best practices, tool integrations, setup guides, and technical expertise.
        </p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            blogs.map((post) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </Heading>
                <p class="mb-3">{post.data.description}</p>
                <div class="text-xs">
                  <p class="mb-1">
                    Author: <span class="font-medium">{post.data.author}</span>
                  </p>
                  <p>
                    URL:{' '}
                    <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                      /blog/{post.id}
                    </code>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>


      <!-- Technical Information -->
      <Notification type="info" variant="accent">
        <div class="space-content">
          <Heading level="h2" size="h6" class="mb-4">Technical sitemap information</Heading>
          <ul>
            <li>
              <span class="font-bold">XML Sitemap:</span> An automated XML sitemap is generated at
              <code>/sitemap.xml</code>
              for search engine optimization.
            </li>
            <li>
              <strong>Generated by:</strong> @astrojs/sitemap integration configured in astro.config.mjs
            </li>
            <li>
              <strong>Last updated:</strong> Automatically updated on each build
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
