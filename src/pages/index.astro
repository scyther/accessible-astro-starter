---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Counter from '@components/Counter.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import { Accordion, AccordionItem, Avatar, AvatarGroup, Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Home">
  <Hero />
  <section id="products" class="my-64">
    <div class="container">
      <Heading level="h2" class="mb-8">Products</Heading>
      <p class="mb-12 text-2xl">Our products bring businesses online. Explore them below.</p>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-2">
        <Feature icon="lucide:school" title="DigiSchool" href="https://digischool.devcase.in"> A complete school website and management system. </Feature>
        <Feature icon="lucide:plane" title="TravelDesk" href="https://traveldesk.devcase.in">
          Bring your travel agency online with package listings and more.
        </Feature>
      </div>
    </div>
  </section>
  <FeaturedPosts />
</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
